rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.wallet == 0;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['email', 'displayName', 'updatedAt']))
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['wallet', 'totalOrders', 'totalSpent', 'updatedAt'])
          && request.resource.data.wallet <= resource.data.wallet
          && request.resource.data.totalOrders >= resource.data.totalOrders
          && request.resource.data.totalSpent >= resource.data.totalSpent);
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.progress == 0;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /recharges/{rechargeId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.upiId == 'Aman7015@fam';
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
